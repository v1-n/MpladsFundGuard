# MPLADS FundGuard Environment Configuration Template
# Copy this file to .env and configure your secrets

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Audit Authentication & Reviewer Credentials
# When AUDIT_AUTH_ENABLED=true, valid tokens are strictly required.
AUDIT_AUTH_ENABLED=true

# Reviewer Tokens Configuration
# Supported formats:
# 1. JSON format: '{"secret-token-1":{"reviewer_id":"Auditor-1","role":"reviewer"},"secret-admin-token":{"reviewer_id":"Lead-Auditor","role":"admin"}}'
# 2. Comma-separated format: secret-token-1:Auditor-1:reviewer,secret-admin-token:Lead-Auditor:admin
AUDIT_REVIEWER_TOKENS='{"auditor-secret-alpha":{"reviewer_id":"Auditor-Alpha","role":"reviewer"},"admin-secret-lead":{"reviewer_id":"Lead-Auditor","role":"admin"}}'
